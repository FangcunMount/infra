global:
  scrape_interval: ${PROMETHEUS_SCRAPE_INTERVAL}
  evaluation_interval: ${PROMETHEUS_SCRAPE_INTERVAL}

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:9090

  # serverD 上的 Prometheus 只能通过本机 docker.sock 发现本机容器。
  # 跨节点业务服务通过 infra-network overlay 静态抓取。
  - job_name: qs-apiserver
    metrics_path: /metrics
    static_configs:
      - targets:
          - ${PROMETHEUS_QS_APISERVER_TARGET}

  - job_name: qs-collection-server
    metrics_path: /metrics
    static_configs:
      - targets:
          - ${PROMETHEUS_QS_COLLECTION_TARGET}

  - job_name: qs-worker
    metrics_path: /metrics
    static_configs:
      - targets:
          - ${PROMETHEUS_QS_WORKER_TARGET}

  - job_name: docker-observed
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: ${PROMETHEUS_SCRAPE_INTERVAL}
        filters:
          - name: label
            values: ["prometheus.scrape=true"]
    relabel_configs:
      - source_labels: [__meta_docker_network_name]
        regex: infra-network
        action: keep
      - source_labels: [__meta_docker_container_label_prometheus_metrics_port]
        target_label: __tmp_metrics_port
      - source_labels: [__meta_docker_port_private]
        target_label: __tmp_metrics_port
        action: keepequal
      - source_labels: [__meta_docker_network_ip, __meta_docker_container_label_prometheus_metrics_port]
        separator: ;
        regex: (.+);(.+)
        replacement: $1:$2
        target_label: __address__
      - source_labels: [__meta_docker_container_label_prometheus_metrics_path]
        regex: (.+)
        target_label: __metrics_path__
      - source_labels: [__meta_docker_container_label_prometheus_job]
        regex: (.+)
        target_label: job
      - source_labels: [__meta_docker_container_label_prometheus_component]
        regex: (.+)
        target_label: component
      - source_labels: [__meta_docker_container_name]
        regex: /(.+)
        replacement: $1
        target_label: instance
      - regex: __tmp_metrics_port
        action: labeldrop
