global:
  scrape_interval: ${PROMETHEUS_SCRAPE_INTERVAL}
  evaluation_interval: ${PROMETHEUS_SCRAPE_INTERVAL}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets:
          - 127.0.0.1:9090

  - job_name: qs-apiserver
    metrics_path: /metrics
    static_configs:
      - targets:
          - qs-apiserver:8080
        labels:
          component: qs-apiserver

  - job_name: qs-worker
    metrics_path: /metrics
    static_configs:
      - targets:
          - qs-worker:9092
        labels:
          component: qs-worker
