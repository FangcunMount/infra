user nginx;
worker_processes 1;
error_log /dev/stderr notice;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

stream {
    log_format proxy '$remote_addr status=$status upstream=$upstream_addr '
                     'bytes_sent=$bytes_sent bytes_received=$bytes_received '
                     'connect_time=$upstream_connect_time session_time=$session_time';
    access_log /dev/stdout proxy;

    upstream mysql_rds {
        server ${MYSQL_HOST}:${MYSQL_PORT} max_fails=3 fail_timeout=5s;
    }

    server {
        listen ${PROXY_BIND_PORT};
        proxy_connect_timeout 5s;
        proxy_timeout 1h;
        proxy_pass mysql_rds;
    }
}
