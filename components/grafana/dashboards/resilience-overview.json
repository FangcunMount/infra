{
  "uid": "resilience-overview",
  "title": "QS Resilience Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["qs", "resilience"],
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Resilience outcomes by kind",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (qs:resilience_decision:rate5m)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "qs:resilience_queue_depth:current",
          "legendFormat": "{{component}} {{scope}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Backpressure in-flight",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "qs:resilience_backpressure_inflight:current",
          "legendFormat": "{{component}} {{scope}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Lock / idempotency / duplicate suppression",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (component, scope, outcome) (qs:resilience_lock:rate5m)",
          "legendFormat": "{{component}} {{scope}} {{outcome}}"
        }
      ]
    }
  ]
}
