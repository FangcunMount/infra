# 生产环境变量模板
# 当前目标拓扑：
#   serverA 4C8G -> nginx + qs-apiserver + qs-collection-server
#   serverB 2C2G -> IAM
#   serverC 4C4G -> mongodb
#   serverD 4C4G -> qs-worker + operating + nsq + prometheus + grafana
#   Mac mini     -> GitHub runners

APP_ENV=production
NODE_ENV=production
TZ=Asia/Shanghai
LANG=zh_CN.UTF-8
LOG_LEVEL=info
DEBUG=false

INFRA_USER=www
INFRA_GROUP=www
INFRA_DATA_ROOT=/data/infra
INFRA_LOG_ROOT=/data/logs
INFRA_NETWORK_ENCRYPTED=false

# Tailscale underlay IPs. Replace with `tailscale ip -4` from each server.
# These IPs are used by Swarm advertise/data-path and by host-level broadcasts.
NODE_A_IP=100.64.0.11
NODE_B_IP=100.64.0.12
NODE_C_IP=100.64.0.13
NODE_D_IP=100.64.0.14
MAC_MINI_IP=100.64.0.15

PRIMARY_DOMAIN=fangcunmount.cn
BLOG_DOMAIN=yangshujie.com

MYSQL_HOST=your-rds.mysql.rds.aliyuncs.com
MYSQL_PORT=3306
MYSQL_USERNAME=your_rds_user
MYSQL_PASSWORD=your_rds_password

REDIS_HOST=your-redis.redis.rds.aliyuncs.com
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your_redis_password

NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
NGINX_MEMORY_LIMIT=1g
NGINX_CPUS=1

NSQLOOKUPD_TCP_PORT=4160
NSQLOOKUPD_HTTP_PORT=4161
NSQD_TCP_PORT=4150
NSQD_HTTP_PORT=4151
NSQADMIN_PORT=4171
NSQLOOKUPD_MEMORY_LIMIT=96M
NSQLOOKUPD_CPUS=0.05
NSQD_MEMORY_LIMIT=512M
NSQD_CPUS=1.00
NSQADMIN_MEMORY_LIMIT=96M
NSQADMIN_CPUS=0.05
NSQD_BROADCAST_ADDRESS=${NODE_D_IP}

PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_SCRAPE_INTERVAL=15s
PROMETHEUS_QS_APISERVER_TARGET=qs-apiserver:8080
PROMETHEUS_QS_COLLECTION_TARGET=qs-collection-server:8080
PROMETHEUS_MEMORY_LIMIT=512M
PROMETHEUS_CPUS=0.25
PROMETHEUS_CONFIG_TEMPLATE_PATH=/data/infra/prometheus/prometheus.yml.tmpl
PROMETHEUS_RULES_PATH=/data/infra/prometheus/rules
PROMETHEUS_URL=http://prometheus:9090

GRAFANA_DOMAIN=grafana.fangcunmount.cn
GRAFANA_ROOT_URL=https://grafana.fangcunmount.cn
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana_admin_password
GRAFANA_MEMORY_LIMIT=256M
GRAFANA_CPUS=0.25
GRAFANA_PROVISIONING_PATH=/data/infra/grafana/provisioning
GRAFANA_DASHBOARDS_PATH=/data/infra/grafana/dashboards

MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change_me_mongo_root_password
MONGO_DATABASE=infrastructure_prod
MONGO_APP_USER=infra_app
MONGO_APP_PASSWORD=change_me_mongo_app_password
MONGO_READONLY_USER=infra_readonly
MONGO_READONLY_PASSWORD=change_me_mongo_readonly_password
MONGO_MEMORY_LIMIT=3072M
MONGO_CPUS=3.00

MONGO_HOST=mongo
NSQLOOKUPD_HOST=nsqlookupd
NSQLOOKUPD_PORT=4161
NSQD_HOST=nsqd
NSQD_PORT=4150
