# Mac mini 基础生产环境模板

TZ=Asia/Shanghai
LANG=zh_CN.UTF-8
INFRA_HOST_LABEL=mac-mini

MAC_MINI_TAILSCALE_IP=100.126.200.55

# 实际运行配置目录（Grafana 凭据单独置于私有目录）
MONITORING_DATA_ROOT=${HOME}/infra-monitoring/config
MONITORING_PRIVATE_ROOT=${HOME}/.config/infra-monitoring
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB
