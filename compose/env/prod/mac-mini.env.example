# Mac mini SonarQube 生产环境模板
# 复制为 mac-mini.env，并将 SONAR_DB_PASSWORD 替换为 serverD 当前实际密码。

TZ=Asia/Shanghai
LANG=zh_CN.UTF-8
INFRA_HOST_LABEL=mac-mini

MAC_MINI_TAILSCALE_IP=100.126.200.55

SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=change_me_sonar_db_password
SONAR_DB_NAME=sonar
SONAR_DOMAIN=sonar.fangcunmount.cn
SONAR_ROOT_URL=https://sonar.fangcunmount.cn

# Docker Desktop 对外发布；serverA 通过 Mac mini Tailscale IP 访问。
SONAR_BIND_ADDRESS=0.0.0.0
SONAR_PORT=9000

SONAR_DB_MEMORY_LIMIT=512M
SONAR_DB_CPUS=0.50
SONAR_MEMORY_LIMIT=3072M
SONAR_CPUS=2.00
