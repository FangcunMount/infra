# =====================================
# 环境配置和敏感数据
# =====================================

# 生产环境配置 (包含密码和密钥)
compose/env/prod/serverA.env
compose/env/prod/serverB.env
.env
.perf-runner-sync.mk

# 备用环境配置
compose/env/*/*
!compose/env/*/.env.example
!compose/env/prod/mac-mini.env.example
!compose/env/*/README.md

# redis ACL 配置文件
components/redis/users.acl

# =====================================
# SSL 证书和密钥文件
# =====================================

# SSL 证书目录 (私钥不入库)
components/nginx/ssl/*
!components/nginx/ssl/README.md
!components/nginx/ssl/.gitkeep

# 证书文件
*.key
*.pem
*.crt
*.pfx
*.jks
*.p12

# Let's Encrypt 相关
.well-known/

# =====================================
# 数据目录和日志文件
# =====================================

# 数据持久化目录
/data/
data/

# 日志文件
logs/
*.log
*.log.*

# 备份文件
backups/
*.sql
*.dump
*.rdb
*.backup

# =====================================
# Docker 和容器相关
# =====================================

# Docker Compose 覆盖文件 (本地开发)
docker-compose.override.yml
docker-compose.local.yml

# Docker 构建缓存
.dockerignore.local

# =====================================
# 临时文件和缓存
# =====================================

# 系统临时文件
.DS_Store
Thumbs.db
*.tmp
*.temp
.cache/

# 编辑器临时文件
*.swp
*.swo
*~
.vscode/settings.json
.idea/

# =====================================
# 构建和依赖
# =====================================

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Go
vendor/

# =====================================
# 监控和运维工具
# =====================================

# Prometheus 数据
prometheus_data/

# Grafana 数据
grafana_data/

# Alertmanager 数据
alertmanager_data/

# =====================================
# 应用特定的忽略
# =====================================

# Jenkins 数据 (包含敏感信息)
jenkins_home/

# 应用上传文件
uploads/
media/
static/collected/

# =====================================
# 脚本生成的文件
# =====================================

# 配置模板渲染结果
*.rendered
*.generated

# 证书申请脚本生成的文件
cert-*.txt
dns-*.txt

# =====================================
# 过程性和临时文档
# =====================================

# 变更日志临时文件
CHANGELOG_*.md
*_CHANGELOG.md

# 集成总结临时文件
*_INTEGRATION*.md
*_ADDED.md
*_SUMMARY.md

# 快速部署指南（应在 docs/ 目录中）
DEPLOY_*.md

# Makefile 备份
Makefile.backup
Makefile.bak

# =====================================
# 安全扫描和审计
# =====================================

# 安全扫描报告
security-scan-*.json
vulnerability-report-*.txt

# 审计日志
audit-*.log

# =====================================
# 备注
# =====================================

# 如需版本化敏感配置，使用 sops + age 加密：
# sops -e compose/env/prod/serverA.env > compose/env/prod/serverA.env.enc
# sops -e compose/env/prod/serverB.env > compose/env/prod/serverB.env.enc
# 然后忽略 .env，保留 .env.enc

# Public official RDS trust bundle; database/client private keys remain ignored.
!components/mysql-client/ca-chain.pem

# Public frozen schema fixture required by the recovery-tool test binary.
!tools/rocketmq-native-recovery/internal/authority/testdata/iam-000045-governance.sql
