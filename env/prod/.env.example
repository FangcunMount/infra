# 生产环境配置文件 - 请勿提交到版本控制
# 复制为 compose/env/prod/.env 并修改相应配置

# =====================================
# 节点信息配置
# =====================================
NODE_A_IP=192.168.1.10
NODE_B_IP=192.168.1.11

# =====================================
# MySQL 数据库配置
# =====================================
MYSQL_ROOT_PASSWORD=your_very_secure_root_password_here
MYSQL_PORT=3306
MYSQL_INNODB_BUFFER_POOL_SIZE=1200M
MYSQL_MAX_CONNECTIONS=150

# =====================================
# Redis 缓存配置
# =====================================
REDIS_PORT=6379
REDIS_MAXMEMORY=384mb
# REDIS_PASSWORD=your_redis_password_here

# =====================================
# MongoDB 文档数据库配置
# =====================================
MONGO_PORT=27017
MONGO_WIRED_TIGER_CACHE_SIZE_GB=0.8

# =====================================
# Kafka 消息队列配置 (节点B)
# =====================================
KAFKA_PORT=9092
KAFKA_ADVERTISED=192.168.1.11
KAFKA_RETENTION_MS=86400000
KAFKA_RETENTION_BYTES=64424509440
KAFKA_HEAP_OPTS=-Xms256m -Xmx512m

# =====================================
# Nginx 反向代理配置
# =====================================
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# =====================================
# Jenkins CI/CD 配置
# =====================================
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=your_jenkins_admin_password
JENKINS_JAVA_OPTS=-Djenkins.install.runSetupWizard=false -Xmx2048m -Xms512m
JENKINS_OPTS=--httpPort=8080 --logfile=/var/log/jenkins/jenkins.log

# =====================================
# 资源限制配置
# =====================================
MYSQL_MEMORY_LIMIT=4096M
REDIS_MEMORY_LIMIT=2048M
MONGO_MEMORY_LIMIT=4096M
KAFKA_MEMORY_LIMIT=4096M
JENKINS_MEMORY_LIMIT=4096M

# =====================================
# 全局配置
# =====================================
TZ=Asia/Shanghai
LOG_LEVEL=info

# =====================================
# 安全配置 (生产环境启用)
# =====================================
# SSL 证书路径 (相对于 components/nginx/ssl/)
SSL_CERT_PATH=example.com/fullchain.pem
SSL_KEY_PATH=example.com/privkey.pem

# 数据库安全
MYSQL_ALLOW_EMPTY_PASSWORD=false
MYSQL_RANDOM_ROOT_PASSWORD=false

# =====================================
# 监控配置 (可选)
# =====================================
ENABLE_MONITORING=false
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000