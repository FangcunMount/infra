# K6 服务端观测入口。复制到 qs-server/tmp/perf/perf.env 后按环境调整。
COLLECTION_METRICS_URL=https://collect.fangcunmount.cn/perf/metrics
COLLECTION_READYZ_URL=https://collect.fangcunmount.cn/perf/readyz
APISERVER_METRICS_URL=https://qs.fangcunmount.cn/metrics
APISERVER_READYZ_URL=https://qs.fangcunmount.cn/readyz
WORKER_METRICS_URL=https://worker.fangcunmount.cn/metrics
WORKER_READYZ_URL=https://worker.fangcunmount.cn/readyz
NSQD_STATS_URL=https://nsqd.fangcunmount.cn/stats

EXPECTED_COLLECTION_REPLICAS=2
EXPECTED_WORKER_REPLICAS=3

# 这只是受控窗口声明；最终仍要求 origin="other" 流量增量为 0。
PERF_ISOLATED_ENV=true

# 共享 NSQD 必须只统计本链路 topic，避免把 cb.failed.* 等无关积压算入恢复门禁。
PERF_NSQ_TOPICS=qs.evaluation.lifecycle,qs.analytics.behavior,qs.plan.task,qs.survey.lifecycle

# 恢复门默认值；只有环境确有依据时才调整。
PERF_RECOVERY_TIMEOUT=5m
PERF_RECOVERY_POLL=10s
