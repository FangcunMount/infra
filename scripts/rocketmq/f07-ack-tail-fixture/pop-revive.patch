+    static long findReviveWitness(MessageStore store, String topic, int queue, String key, String sourceKey,
+        boolean rewritten, MessageExt source) {
+        long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(3);
+        while (store.dispatchBehindBytes() != 0) {
+            if (System.nanoTime() >= deadline) {
+                throw new IllegalStateException("retry witness dispatch is incomplete");
+            }
+            try {
+                Thread.sleep(10);
+            } catch (InterruptedException failure) {
+                Thread.currentThread().interrupt();
+                throw new IllegalStateException("retry witness verification interrupted", failure);
+            }
+        }
+        long sourcePosition = source.getCommitLogOffset();
+        requireRetainedSource(store, sourcePosition);
+        ConsumeQueueInterface index = store.getConsumeQueue(topic, queue);
+        if (index == null) {
+            return -1;
+        }
+        long lower = index.getMinOffsetInQueue();
+        long upper = index.getMaxOffsetInQueue();
+        if (index.getCQType() != CQType.SimpleCQ || lower < 0 || upper < lower) {
+            throw new IllegalStateException("retry witness scan requires a valid simple ConsumeQueue");
+        }
+        // Ordinary ConsumeQueue entries are ordered by CommitLog position.
+        // A retry was appended after its source, even across file rotation.
+        long first = firstRetryAfterSource(index, lower, upper, sourcePosition);
+        long found = -1;
+        boolean uncertainLegacy = false;
+        String sourceId = source.getProperty(MessageConst.PROPERTY_UNIQ_CLIENT_MESSAGE_ID_KEYIDX);
+        long previousPosition = sourcePosition;
+        for (long offset = first; offset < upper; offset++) {
+            CqUnit entry = requireRetryIndexEntry(index, offset);
+            if (entry.getPos() <= previousPosition) {
+                throw new IllegalStateException("retry witness physical positions are not ordered");
+            }
+            previousPosition = entry.getPos();
+            SelectMappedBufferResult raw = store.selectOneMessageByOffset(entry.getPos(), entry.getSize());
+            if (raw == null) {
+                throw new IllegalStateException("retry witness CommitLog entry is unavailable");
+            }
+            try {
+                MessageExt retained = MessageDecoder.decode(raw.getByteBuffer().duplicate(), false, false);
+                if (retained == null || !topic.equals(retained.getTopic()) || retained.getQueueId() != queue
+                    || retained.getQueueOffset() != offset || retained.getCommitLogOffset() != entry.getPos()
+                    || retained.getStoreSize() != entry.getSize()) {
+                    throw new IllegalStateException("retry witness physical identity mismatch");
+                }
+                String storedKey = retained.getProperty(REVIVE_WITNESS);
+                String storedSourceKey = retained.getProperty(REVIVE_SOURCE_WITNESS);
+                boolean legacyMatch = key.equals(storedKey);
+                boolean sourceMatch = sourceKey.equals(storedSourceKey);
+                boolean sameMessage = java.util.Objects.equals(sourceId,
+                    retained.getProperty(MessageConst.PROPERTY_UNIQ_CLIENT_MESSAGE_ID_KEYIDX))
+                    && retained.getReconsumeTimes() == source.getReconsumeTimes() + 1;
+                if (legacyMatch || sourceMatch) {
+                    if ((legacyMatch && storedSourceKey != null && !sourceMatch) || (sourceMatch && storedKey == null)) {
+                        throw new IllegalStateException("retry witness identities disagree");
+                    }
+                    MessageExt match = MessageDecoder.decode(raw.getByteBuffer().duplicate(), true, true);
+                    if (found >= 0 || match == null || !sameMessage || !Arrays.equals(source.getBody(), match.getBody())) {
+                        throw new IllegalStateException("retry witness is ambiguous or differs from the source");
+                    }
+                    found = entry.getPos();
+                } else if (rewritten && storedKey != null && storedSourceKey == null && sameMessage) {
+                    uncertainLegacy = true;
+                }
+            } finally {
+                raw.release();
+            }
+        }
+        requireRetainedSource(store, sourcePosition);
+        if (store.getConsumeQueue(topic, queue) != index || index.getMinOffsetInQueue() != lower
+            || index.getMaxOffsetInQueue() < upper) {
+            throw new IllegalStateException("retry witness ConsumeQueue changed during the scan");
+        }
+        if (found < 0 && uncertainLegacy) {
+            throw new IllegalStateException("rewritten checkpoint cannot prove the retained legacy retry identity");
+        }
+        return found;
+    }
