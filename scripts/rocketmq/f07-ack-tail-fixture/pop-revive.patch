+    private static long firstRetryAfterSource(ConsumeQueueInterface index, long lower, long upper, long sourcePosition) {
+        long left = lower;
+        long right = upper;
+        while (left < right) {
+            long mid = left + (right - left) / 2;
+            if (requireRetryIndexEntry(index, mid).getPos() <= sourcePosition) {
+                left = mid + 1;
+            } else {
+                right = mid;
+            }
+        }
+        if ((left > lower && requireRetryIndexEntry(index, left - 1).getPos() > sourcePosition)
+            || (left < upper && requireRetryIndexEntry(index, left).getPos() <= sourcePosition)) {
+            throw new IllegalStateException("retry witness search boundary is inconsistent");
+        }
+        return left;
+    }
+
+    private static CqUnit requireRetryIndexEntry(ConsumeQueueInterface index, long offset) {
+        CqUnit entry = index.get(offset);
+        if (entry == null || entry.getQueueOffset() != offset || entry.getPos() < 0 || entry.getSize() <= 0
+            || entry.getBatchNum() != 1) {
+            throw new IllegalStateException("retry witness ConsumeQueue entry is unavailable");
+        }
+        return entry;
+    }
