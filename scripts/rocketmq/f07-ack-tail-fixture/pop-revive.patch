+            if (!older.getTopic().startsWith(MixAll.RETRY_GROUP_TOPIC_PREFIX)) {
+                continue;
+            }
+            for (int index = 0; index < older.getNum(); index++) {
+                if (DataConverter.getBit(older.getBitMap(), index)) {
+                    continue;
+                }
+                long sourceOffset = older.ackOffsetByIndex((byte) index);
+                RetryAck ack = evidence.get(retryAckIdentity(older, sourceOffset));
+                if (ack == null || ack.popTime <= older.getPopTime()) {
+                    continue;
+                }
+                ConsumeQueueInterface queue = store.getConsumeQueue(older.getTopic(), older.getQueueId());
+                CqUnit entry = queue == null ? null : queue.get(sourceOffset);
+                if (entry == null || entry.getQueueOffset() != sourceOffset) {
+                    continue;
+                }
+                SelectMappedBufferResult raw = store.selectOneMessageByOffset(entry.getPos(), entry.getSize());
