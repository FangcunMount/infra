+    private long advanceVerifiedAckTail(long committed) {
+        if (committed < 0 || !shouldRunPopRevive || !inflightReviveRequestMap.isEmpty()) {
+            return committed;
+        }
+        MessageStore store = brokerController.getMessageStore();
+        ConsumeQueueInterface queue = store.getConsumeQueue(reviveTopic, queueId);
+        if (queue == null || queue.getMaxOffsetInQueue() <= committed + 1) {
+            return committed;
+        }
+        long oldest = Math.max(queue.getMinOffsetInQueue(), committed - ACK_TAIL_LOOKBACK + 1);
+        long end = Math.min(queue.getMaxOffsetInQueue(), committed + 1 + ACK_TAIL_SCAN_LIMIT);
+        Map<String, PopCheckPoint> checkpoints = new HashMap<>();
+        long verified = committed;
+        for (long offset = committed + 1; offset < end; offset++) {
+            MessageExt record = readReviveRecord(queue, offset);
+            if (record == null || !(PopAckConstants.ACK_TAG.equals(record.getTags())
+                || PopAckConstants.BATCH_ACK_TAG.equals(record.getTags()))) {
+                break;
+            }
+            if (offset == committed + 1) {
+                for (long prior = committed; prior >= oldest; prior--) {
+                    MessageExt checkpoint = readReviveRecord(queue, prior);
+                    if (checkpoint == null) {
+                        // An unreadable slot in the retained range can hide a second CK with the same key.
+                        return committed;
+                    }
+                    if (PopAckConstants.CK_TAG.equals(checkpoint.getTags())) {
+                        PopCheckPoint point = parseAckTailRecord(checkpoint, PopCheckPoint.class);
+                        if (point == null) {
+                            return committed;
+                        }
+                        point.setReviveOffset(prior);
+                        rememberAckCheckpoint(checkpoints, ackCheckpointIdentity(point.getTopic(), point.getCId(),
+                            point.getQueueId(), point.getStartOffset(), point.getPopTime(), point.getBrokerName()), point);
+                    }
+                }
+            }
+            AckMsg ack = PopAckConstants.BATCH_ACK_TAG.equals(record.getTags())
