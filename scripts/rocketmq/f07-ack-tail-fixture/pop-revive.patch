+    private MessageExt readReviveRecord(ConsumeQueueInterface queue, long offset) {
+        CqUnit entry = queue.get(offset);
+        if (entry == null || entry.getQueueOffset() != offset || entry.getPos() < 0 || entry.getSize() <= 0) {
+            return null;
+        }
+        SelectMappedBufferResult raw = brokerController.getMessageStore().selectOneMessageByOffset(entry.getPos(), entry.getSize());
+        if (raw == null) {
+            return null;
+        }
+        try {
+            MessageExt record = MessageDecoder.decode(raw.getByteBuffer(), true, true, false, false, true);
+            return record != null && reviveTopic.equals(record.getTopic()) && queueId == record.getQueueId()
+                && record.getQueueOffset() == offset && record.getCommitLogOffset() == entry.getPos() ? record : null;
+        } finally {
+            raw.release();
+        }
+    }
