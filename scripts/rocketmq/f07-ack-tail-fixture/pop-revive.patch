+    private static void requireRetainedSource(MessageStore store, long sourcePosition) {
+        if (sourcePosition < 0 || sourcePosition < store.getMinPhyOffset() || sourcePosition >= store.getMaxPhyOffset()) {
+            throw new IllegalStateException("retry witness source is outside the retained CommitLog");
+        }
+    }
