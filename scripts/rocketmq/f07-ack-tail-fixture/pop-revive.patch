+    static boolean coversCheckpointOffset(AckMsg ack, PopCheckPoint point) {
+        if (point == null || StringUtils.isBlank(point.getTopic()) || StringUtils.isBlank(point.getCId())
+            || point.getNum() <= 0 || point.getStartOffset() < 0 || ack.getPopTime() <= 0) {
+            return false;
+        }
+        List<Integer> differences = point.getQueueOffsetDiff();
+        if (differences != null && !differences.isEmpty() && differences.size() != point.getNum()) {
+            return false;
+        }
+        if (ack instanceof BatchAckMsg) {
+            List<Long> offsets = ((BatchAckMsg) ack).getAckOffsetList();
+            return offsets != null && !offsets.isEmpty() && offsets.size() <= point.getNum()
+                && offsets.stream().distinct().count() == offsets.size()
+                && offsets.stream().allMatch(offset -> offset != null && containsExactOffset(point, offset));
+        }
+        return containsExactOffset(point, ack.getAckOffset());
+    }
+
+    private static boolean containsExactOffset(PopCheckPoint point, long offset) {
+        if (offset < point.getStartOffset()) {
+            return false;
+        }
+        long difference = offset - point.getStartOffset();
+        List<Integer> differences = point.getQueueOffsetDiff();
+        if (differences == null || differences.isEmpty()) {
+            return difference < point.getNum();
+        }
+        return difference <= Integer.MAX_VALUE && differences.contains((int) difference);
+    }
